void tao_ngau_nhien(int n,int wmax,ll g[n][n]){
    clr(n,g);
    for(int i=1;i<n;i++){
        int p=rand()%i;
        int w=1+rand()%wmax;
        g[i][p]=w;
        g[p][i]=w;
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(g[i][j]==0){
                int w=1+rand()%wmax;
                g[i][j]=w;
                g[j][i]=w;
            }
        }
    }
}

int lien_thong(int n,ll g[n][n]){
    int *vis=calloc(n,sizeof(int));
    int *q=malloc(n*sizeof(int));
    int dau=0,cuoi=0;
    int dem=0;
    q[cuoi++]=0;
    vis[0]=1;

    while(dau<cuoi){
        int u=q[dau++];
        dem++;
        for(int i=0;i<n;i++){
            if(g[u][i]>0 && !vis[i]){
                vis[i]=1;
                q[cuoi++]=i;
            }
        }
    }
    free(vis);
    free(q);
    return dem==n;
}

void dfs(int n,ll g[n][n],ll u,int vis[]){
    vis[u]=1;
    for(ll v=0;v<n;v++){
        if(g[u][v]>0 && !vis[v]){
            printf("(%lld) ----%lld----> (%lld)\n",u+1,g[u][v],v+1);
            dfs(n,g,v,vis);
        }
    }
}

