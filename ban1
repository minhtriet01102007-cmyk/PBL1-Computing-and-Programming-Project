    line();

    printf(RESET);

    printf("%5s"," ");

    for(int i=0;i<n;i++){
        printf("%5lld",i+1);
    }

    printf("\n");

    line();

    for(int i=0;i<n;i++){

        printf("%5lld",i+1);

        for(int j=0;j<n;j++){
            printf("%5lld",g[i][j]);
        }

        printf("\n");
    }

    line();
}

void nhap_mt(int n,int g[n][n]){

    clr(n,g);

    line();

    printf(YELLOW);
    printf("NHAP MA TRAN DOI XUNG\n");

    line();

    printf(RESET);

    for(int i=0;i<n;i++){

        for(int j=i+1;j<n;j++){

            int w;

            printf("Nhap a[%lld][%lld] = ",i+1,j+1);

            scanf("%lld",&w);

            if(w<0) w=0;

            g[i][j]=w;
            g[j][i]=w;
        }
    }
}

void tao_ngau_nhien(int n,int wmax,int g[n][n]){

    clr(n,g);

    for(int i=1;i<n;i++){

        int p=rand()%i;
        int w=1+rand()%wmax;

        g[i][p]=w;
        g[p][i]=w;
    }

    for(int i=0;i<n;i++){

        for(int j=i+1;j<n;j++){

            if(g[i][j]==0){

                int w=1+rand()%wmax;

                g[i][j]=w;
                g[j][i]=w;
            }
        }
    }
}

int lien_thong(int n,int g[n][n]){

    int *vis=calloc(n,sizeof(int));
    int *q=malloc(n*sizeof(int));

    int dau=0,cuoi=0;
    int dem=0;

    q[cuoi++]=0;
    vis[0]=1;

    while(dau<cuoi){

        int u=q[dau++];
        dem++;

        for(int i=0;i<n;i++){

            if(g[u][i]>0 && !vis[i]){

                vis[i]=1;
                q[cuoi++]=i;
            }
        }
    }

    free(vis);
    free(q);

    return dem==n;
}

void dfs(int n,int g[n][n],int u,int vis[]){

    vis[u]=1;

    for(int v=0;v<n;v++){

        if(g[u][v]>0 && !vis[v]){

            printf("(%lld) ----%lld----> (%lld)\n",
                   u+1,g[u][v],v+1);

            dfs(n,g,v,vis);
        }
    }
}

void cay_dfs(int n,int g[n][n],int s){

    int *vis=calloc(n,sizeof(int));

    line();

    printf(YELLOW);
    printf("                 CAY PHU DFS\n");

    line();

    printf(RESET);

    dfs(n,g,s,vis);

    free(vis);
}

void cay_bfs(int n,int g[n][n],int s){

    int *vis=calloc(n,sizeof(int));
    int *q=malloc(n*sizeof(int));

    int dau=0,cuoi=0;

    vis[s]=1;
    q[cuoi++]=s;

    line();

    printf(YELLOW);
    printf("                 CAY PHU BFS\n");

    line();

    printf(RESET);

    while(dau<cuoi){

        int u=q[dau++];

        for(int i=0;i<n;i++){

            if(g[u][i]>0 && !vis[i]){

                vis[i]=1;

                printf("(%lld) ----%lld----> (%lld)\n",
                       u+1,g[u][i],i+1);

                q[cuoi++]=i;
            }
        }
    }

    free(vis);
    free(q);
}

int la_euler(int n,int g[n][n]){

    if(!lien_thong(n,g)){
        return 0;
    }

    for(int i=0;i<n;i++){

        int bac=0;

        for(int j=0;j<n;j++){

            if(g[i][j]>0){
                bac++;
            }
        }

        if(bac%2!=0){
            return 0;
        }
    }

    return 1;
}

/* ====================== DIJKSTRA ====================== */

void dijkstra(int n,int g[n][n],int s,int t){

    int inf=1000000000000000000LL;

    int *d=malloc(n*sizeof(int));
    int *truoc=malloc(n*sizeof(int));
    int *vis=calloc(n,sizeof(int));

    for(int i=0;i<n;i++){

        d[i]=inf;
        truoc[i]=-1;
    }

    d[s]=0;

    for(int i=0;i<n;i++){

        int u=-1;
        int best=inf;

        for(int j=0;j<n;j++){

            if(!vis[j] && d[j]<best){

                best=d[j];
                u=j;
            }
        }

        if(u==-1) break;

        vis[u]=1;

        for(int v=0;v<n;v++){

            if(g[u][v]>0 && !vis[v]){

                if(d[v] > d[u]+g[u][v]){

                    d[v]=d[u]+g[u][v];
                    truoc[v]=u;
                }
            }
        }
    }

    line();

    if(d[t]==inf){

        printf(RED);
        printf("Khong co duong di!\n");

    }else{

        printf(GREEN);

        printf("Do dai ngan nhat = %lld\n",d[t]);

        int path[n];
        int k=0;

        int x=t;

        while(x!=-1){

            path[k++]=x;
            x=truoc[x];
        }

        printf("Duong di: ");

        for(int i=k-1;i>=0;i--){

            printf("%lld",path[i]+1);

            if(i>0) printf(" -> ");
        }

        printf("\n");
    }

    printf(RESET);

    line();

    free(d);
    free(truoc);
    free(vis);
}

/* ====================== PRIM ====================== */

void prim(int n,int g[n][n]){

    int inf=1000000000000000000LL;

    int *chon=calloc(n,sizeof(int));
    int *khoa=malloc(n*sizeof(int));
    int *truoc=malloc(n*sizeof(int));

    int tong=0;

    for(int i=0;i<n;i++){

        khoa[i]=inf;
        truoc[i]=-1;
    }

    khoa[0]=0;

    for(int i=0;i<n;i++){

        int u=-1;
        int best=inf;

        for(int v=0;v<n;v++){

            if(!chon[v] && khoa[v]<best){

                best=khoa[v];
                u=v;
            }
        }

        if(u==-1) break;

        chon[u]=1;

        for(int v=0;v<n;v++){

            if(g[u][v]>0 && !chon[v] && g[u][v]<khoa[v]){

                khoa[v]=g[u][v];
                truoc[v]=u;
            }
        }
    }

    line();

    printf(YELLOW);
    printf("           CAY KHUNG NHO NHAT PRIM\n");

    line();

    printf(RESET);

    for(int i=1;i<n;i++){

        printf("%lld -- %lld : %lld\n",
               truoc[i]+1,
               i+1,
               g[truoc[i]][i]);

        tong+=g[truoc[i]][i];
    }

    line();

    printf(GREEN);
    printf("Tong trong so MST = %lld\n",tong);

    printf(RESET);

    line();

    free(chon);
    free(khoa);
    free(truoc);
}

/* ====================== KRUSKAL ====================== */

int goc(int par[],int x){

    while(x!=par[x]){

        par[x]=par[par[x]];
        x=par[x];
    }

    return x;
}

void hop(int par[],int rank[],int a,int b){

    int ga=goc(par,a);
    int gb=goc(par,b);

    if(ga==gb) return;

    if(rank[ga]<rank[gb]){

        par[ga]=gb;

    }else if(rank[ga]>rank[gb]){

        par[gb]=ga;

    }else{

        par[gb]=ga;
        rank[ga]++;
    }
}

int cmp(const void *x, const void *y) {
    const Canh *c1 = (const Canh*)x;
    const Canh *c2 = (const Canh*)y;

    if (c1->w < c2->w) return -1;
    if (c1->w > c2->w) return 1;
    return 0;
}


void kruskal(int n,int g[n][n]){

    int mmax=n*(n-1)/2;

    Canh *ds=malloc(mmax*sizeof(Canh));

    int *par=malloc(n*sizeof(int));
    int *rank=calloc(n,sizeof(int));

    int m=0;
    int tong=0;
    int dem=0;

    for(int i=0;i<n;i++){
        par[i]=i;
    }

    for(int i=0;i<n;i++){

        for(int j=i+1;j<n;j++){

            if(g[i][j]>0){

                ds[m].u=i;
                ds[m].v=j;
                ds[m].w=g[i][j];

                m++;
            }
        }
    }
    qsort(ds, m, sizeof(Canh), cmp);


    line();

    printf(YELLOW);
    printf("         CAY KHUNG NHO NHAT KRUSKAL\n");

    line();

    printf(RESET);

    for(int i=0;i<m;i++){

        int u=ds[i].u;
        int v=ds[i].v;

        if(goc(par,u)!=goc(par,v)){

            printf("%lld -- %lld : %lld\n",
                   u+1,v+1,ds[i].w);

            tong+=ds[i].w;

            hop(par,rank,u,v);

            dem++;

            if(dem==n-1) break;
        }
    }

    line();

    printf(GREEN);
    printf("Tong trong so MST = %lld\n",tong);

    printf(RESET);

    line();

    free(ds);
    free(par);
    free(rank);
}

