void cay_bfs(int n,ll g[n][n],int s){
    int *vis=calloc(n,sizeof(int));
    int *q=malloc(n*sizeof(int));
    int dau=0,cuoi=0;
    vis[s]=1;
    q[cuoi++]=s;
    line();
    printf(YELLOW);
    printf("                 CAY PHU BFS\n");
    printf("\n");
    printf(RESET);

    while(dau<cuoi){
        int u=q[dau++];
        for(int i=0;i<n;i++){
            if(g[u][i]>0 && !vis[i]){
                vis[i]=1;
                printf("(%lld) ----%lld----> (%d)\n",u+1,g[u][i],i+1);
                q[cuoi++]=i;
            }
        }
    }
    free(vis);
    free(q);
}

int la_euler(int n,ll g[n][n]){
    if(!lien_thong(n,g)){
        return 0;
    }
    for(int i=0;i<n;i++){
        int bac=0;
        for(int j=0;j<n;j++){
            if(g[i][j]>0){
                bac++;
            }
        }
        if(bac%2!=0){
            return 0;
        }
    }
    return 1;
}

void dijkstra(int n,ll g[n][n],int s,int t){
    long long inf = LLONG_MAX;
    ll *d=malloc(n*sizeof(int));
    int *truoc=malloc(n*sizeof(int));
    int *vis=calloc(n,sizeof(int));

    for(int i=0;i<n;i++){
        d[i]=inf;
        truoc[i]=-1;
    }
    d[s]=0;
    for(int i=0;i<n;i++){
        int u=-1;
        ll best=inf;
        for(int j=0;j<n;j++){
            if(!vis[j] && d[j]<best){
                best=d[j];
                u=j;
            }
        }
        if(u==-1) break;
        vis[u]=1;
        for(int v=0;v<n;v++){
            if(g[u][v]>0 && !vis[v]){
                if(d[v] > d[u]+g[u][v]){
                    d[v]=d[u]+g[u][v];
                    truoc[v]=u;
                }
            }
        }
    }
    line();
    printf("\n        DUONG DI NGAN NHAT\n");
    if(d[t]==inf){
        printf(RED);
        printf("Khong co duong di!\n");
    }else{
        printf(GREEN);
        printf("Do dai ngan nhat = %lld\n",d[t]);
        int path[n];
        int k=0;
        int x=t;

        while(x!=-1){
            path[k++]=x;
            x=truoc[x];
        }
        printf("Duong di: ");
        for(int i=k-1;i>=0;i--){
            printf("%d",path[i]+1);
            if(i>0) printf(" -> ");
        }
        printf("\n");
    }
    printf(RESET);
    line();
    free(d);
    free(truoc);
    free(vis);
}

void prim(int n,ll g[n][n]){
    long long inf = LLONG_MAX;
    int *chon=calloc(n,sizeof(int));
    ll *khoa=malloc(n*sizeof(int));
    int *truoc=malloc(n*sizeof(int));
    int tong=0;

    for(int i=0;i<n;i++){
        khoa[i]=inf;
        truoc[i]=-1;
    }
    khoa[0]=0;
    for(int i=0;i<n;i++){
        int u=-1;
        ll best=inf;

        for(int v=0;v<n;v++){
            if(!chon[v] && khoa[v]<best){
                best=khoa[v];
                u=v;
            }
        }
        if(u==-1) break;
        chon[u]=1;

        for(int v=0;v<n;v++){
            if(g[u][v]>0 && !chon[v] && g[u][v]<khoa[v]){
                khoa[v]=g[u][v];
                truoc[v]=u;
            }
        }
    }
    line();
    printf(YELLOW);
    printf("           CAY KHUNG NHO NHAT PRIM\n");
    printf("\n");
    printf(RESET);
    for(int i=1;i<n;i++){
        printf("%lld -- %lld : %lld\n",truoc[i]+1,i+1,g[truoc[i]][i]);
        tong+=g[truoc[i]][i];
    }
    printf(GREEN);
    printf("Tong trong so MST = %lld\n",tong);
    printf(RESET);
    line();
    free(chon);
    free(khoa);
    free(truoc);
}

int goc(int par[],int x){
    while(x!=par[x]){
        par[x]=par[par[x]];
        x=par[x];
    }
    return x;
}

void hop(int par[],int rank[],int a,int b){
    int ga=goc(par,a);
    int gb=goc(par,b);
    if(ga==gb) return;
    if(rank[ga]<rank[gb]){
        par[ga]=gb;
    }else if(rank[ga]>rank[gb]){
        par[gb]=ga;
    }else{
        par[gb]=ga;
        rank[ga]++;
    }
}

int cmp(const void *a, const void *b) {
    const Canh *x = (const Canh*)a;
    const Canh *y = (const Canh*)b;

    if (x->w < y->w) return -1;
    if (x->w > y->w) return 1;
    return 0;
}

void kruskal(int n,ll g[n][n]){
    int mmax=n*(n-1)/2;
    Canh *ds=malloc(mmax*sizeof(Canh));
    int *par=malloc(n*sizeof(int));
    int *rank=calloc(n,sizeof(int));
    int m=0;
    ll tong=0;
    int dem=0;

    for(int i=0;i<n;i++){
        par[i]=i;
    }
    for(int i=0;i<n;i++){
        for(int j=i+1;j<n;j++){
            if(g[i][j]>0){
                ds[m].u=i;
                ds[m].v=j;
                ds[m].w=g[i][j];
                m++;
            }
        }
    }
    qsort(ds, m, sizeof(Canh), cmp);
    line();
    printf(YELLOW);
    printf("         CAY KHUNG NHO NHAT KRUSKAL\n");
    printf("\n");
    printf(RESET);
    for(int i=0;i<m;i++){
        ll u=ds[i].u;
        ll v=ds[i].v;
        if(goc(par,u)!=goc(par,v)){
            printf("%lld -- %lld : %lld\n",u+1,v+1,ds[i].w);
            tong+=ds[i].w;
            hop(par,rank,u,v);
            dem++;
            if(dem==n-1) break;
        }
    }
    printf(GREEN);
    printf("Tong trong so MST = %lld\n",tong);
    printf(RESET);
    line();
    free(ds);
    free(par);
    free(rank);
}

